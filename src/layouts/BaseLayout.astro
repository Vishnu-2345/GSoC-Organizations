---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'GSoC Organizations',
  description = 'Search, compare, and shortlist Google Summer of Code organizations using public archive data and transparent source links.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F9AB00" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/brand/gsoc-organizations-favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/brand/gsoc-organizations-favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/brand/gsoc-organizations-favicon-16x16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/brand/gsoc-organizations-apple-touch-icon.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div id="main-content">
      <slot />
    </div>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a
            class="footer-brand-link"
            href="/"
            aria-label="GSoC Organizations footer home"
          >
            <img
              src="/brand/gsoc-organizations-logo.svg"
              alt=""
              width="54"
              height="54"
            />
            <span>GSoC Organizations</span>
          </a>
          <p>
            A comprehensive directory of Google Summer of Code organizations
            across every archived program year, helping aspiring open-source
            contributors discover projects, explore participation history, and
            find opportunities to contribute.
          </p>
        </div>
        <div class="footer-link-grid">
          <nav class="footer-column" aria-labelledby="footer-project-heading">
            <h2 id="footer-project-heading">Project</h2>
            <a href="/about/">About the data</a>
            <a href="/privacy/">Privacy policy</a>
            <a
              href="https://github.com/rohanmalhotracodes/GSoC-Organizations"
              target="_blank"
              rel="noreferrer">GitHub repository</a
            >
            <a
              href="https://summerofcode.withgoogle.com/"
              target="_blank"
              rel="noreferrer">Official GSoC</a
            >
            <a
              class="github-star-link"
              href="https://github.com/rohanmalhotracodes/GSoC-Organizations"
              target="_blank"
              rel="noreferrer"
              aria-label="Star GSoC Organizations on GitHub"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="m12 2.7 2.7 5.48 6.05.88-4.38 4.27 1.03 6.03L12 16.52l-5.4 2.84 1.03-6.03-4.38-4.27 6.05-.88L12 2.7Z"
                ></path>
              </svg>
              <span>Star on GitHub</span>
              <span
                class="github-star-count"
                data-github-star-count
                data-testid="github-star-count">—</span
              >
            </a>
            <span class="sr-only" data-github-star-status aria-live="polite"
              >Live repository stars</span
            >
          </nav>
          <nav class="footer-column" aria-labelledby="footer-creator-heading">
            <h2 id="footer-creator-heading">Created by</h2>
            <p><strong>Rohan Malhotra</strong></p>
            <a
              href="https://www.linkedin.com/in/rohanmalhotracodes/"
              target="_blank"
              rel="noreferrer">LinkedIn</a
            >
            <a
              href="https://x.com/rohangotnochill"
              target="_blank"
              rel="noreferrer">X</a
            >
            <a
              href="https://github.com/rohanmalhotracodes"
              target="_blank"
              rel="noreferrer">GitHub</a
            >
          </nav>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© 2026 Rohan Malhotra.</span>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const countElements = document.querySelectorAll(
          '[data-github-star-count]',
        );
        const statusElements = document.querySelectorAll(
          '[data-github-star-status]',
        );
        if (!countElements.length) return;

        const cacheKey = 'gsoc-organizations-github-stars';
        const cacheDuration = 15 * 60 * 1000;

        const showCount = (count) => {
          const formattedCount = new Intl.NumberFormat().format(count);
          countElements.forEach((element) => {
            element.textContent = formattedCount;
          });
          statusElements.forEach((element) => {
            element.textContent = `${formattedCount} GitHub ${count === 1 ? 'star' : 'stars'}`;
          });
        };

        try {
          const cached = JSON.parse(sessionStorage.getItem(cacheKey) || 'null');
          if (
            cached &&
            Number.isInteger(cached.count) &&
            Date.now() - cached.updatedAt < cacheDuration
          ) {
            showCount(cached.count);
            return;
          }
        } catch {}

        fetch(
          'https://api.github.com/repos/rohanmalhotracodes/GSoC-Organizations',
          { headers: { Accept: 'application/vnd.github+json' } },
        )
          .then((response) => {
            if (!response.ok) throw new Error('Unable to load GitHub stars');
            return response.json();
          })
          .then((repository) => {
            if (!Number.isInteger(repository.stargazers_count)) return;
            showCount(repository.stargazers_count);
            try {
              sessionStorage.setItem(
                cacheKey,
                JSON.stringify({
                  count: repository.stargazers_count,
                  updatedAt: Date.now(),
                }),
              );
            } catch {}
          })
          .catch(() => {
            statusElements.forEach((element) => {
              element.textContent = 'View repository stars on GitHub';
            });
          });
      })();
    </script>
  </body>
</html>
