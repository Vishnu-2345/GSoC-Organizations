---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  pageType?: 'WebPage' | 'CollectionPage' | 'AboutPage';
  pageAboutId?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'GSoC Organizations',
  description = 'A comprehensive directory of Google Summer of Code organizations across every archived program year. Explore organizations, projects, technologies, topics, and participation history.',
  image = '/brand/gsoc-organizations-logo-1024.png',
  noindex = false,
  pageType = 'WebPage',
  pageAboutId,
  structuredData = [],
} = Astro.props;

const siteUrl = new URL('/', Astro.site ?? 'https://gsocorganizations.xyz');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImageUrl = new URL(image, siteUrl);
const isHomePage = canonicalUrl.pathname === '/';
const additionalStructuredData = Array.isArray(structuredData)
  ? structuredData
  : [structuredData];
const webPageData: Record<string, unknown> = {
  '@type': isHomePage ? 'CollectionPage' : pageType,
  '@id': `${canonicalUrl.href}#webpage`,
  url: canonicalUrl.href,
  name: title,
  description,
  isPartOf: { '@id': `${siteUrl.href}#website` },
  inLanguage: 'en',
};

if (pageAboutId) {
  webPageData.about = { '@id': pageAboutId };
}

const graph = [
  ...(isHomePage
    ? [
        {
          '@type': 'WebSite',
          '@id': `${siteUrl.href}#website`,
          url: siteUrl.href,
          name: 'GSoC Organizations',
          description,
          inLanguage: 'en',
        },
      ]
    : []),
  webPageData,
  ...additionalStructuredData,
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex,follow'
        : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}
    />
    <meta name="theme-color" content="#F9AB00" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GSoC Organizations" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta
      property="og:image:alt"
      content="GSoC Organizations golden code badge"
    />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="icon" href="/brand/gsoc-organizations-favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/brand/gsoc-organizations-favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/brand/gsoc-organizations-favicon-16x16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/brand/gsoc-organizations-apple-touch-icon.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      as="image"
      type="image/svg+xml"
      href="/brand/gsoc-organizations-logo.svg"
    />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-loading" role="status" aria-live="polite">
      <div class="site-loading-mark" aria-hidden="true">
        <img
          src="/brand/gsoc-organizations-logo.svg"
          alt=""
          width="64"
          height="64"
        />
        <span class="site-loading-spinner"></span>
      </div>
      <span data-loading-message>Loading GSoC Organizations…</span>
      <small data-loading-detail>Preparing the page</small>
    </div>
    <div id="main-content">
      <slot />
    </div>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a
            class="footer-brand-link"
            href="/"
            aria-label="GSoC Organizations footer home"
          >
            <img
              src="/brand/gsoc-organizations-logo.svg"
              alt=""
              width="54"
              height="54"
            />
            <span>GSoC Organizations</span>
          </a>
          <p>
            A comprehensive directory of Google Summer of Code organizations
            across every archived program year, helping aspiring open-source
            contributors discover projects, explore participation history, and
            find opportunities to contribute.
          </p>
        </div>
        <div class="footer-link-grid">
          <nav class="footer-column" aria-labelledby="footer-project-heading">
            <h2 id="footer-project-heading">Project</h2>
            <a href="/about/">About the data</a>
            <a href="/privacy/">Privacy policy</a>
            <a
              href="https://github.com/rohanmalhotracodes/GSoC-Organizations"
              target="_blank"
              rel="noreferrer">GitHub repository</a
            >
            <a
              href="https://summerofcode.withgoogle.com/"
              target="_blank"
              rel="noreferrer">Official GSoC</a
            >
            <a
              class="github-star-link"
              href="https://github.com/rohanmalhotracodes/GSoC-Organizations"
              target="_blank"
              rel="noreferrer"
              aria-label="Star GSoC Organizations on GitHub"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.36-3.9-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.57-.29-5.27-1.28-5.27-5.68 0-1.25.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.96 10.96 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.1 0 4.41-2.71 5.39-5.29 5.68.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
                ></path>
              </svg>
              <span>Star</span>
              <span
                class="github-star-count"
                data-github-star-count
                data-testid="github-star-count">1</span
              >
            </a>
            <span class="sr-only" data-github-star-status aria-live="polite"
              >1 GitHub star</span
            >
          </nav>
          <nav class="footer-column" aria-labelledby="footer-creator-heading">
            <h2 id="footer-creator-heading">Created by</h2>
            <p><strong>Rohan Malhotra</strong></p>
            <div class="footer-social-links" aria-label="Social profiles">
              <a
                class="social-icon-link"
                href="https://www.linkedin.com/in/rohanmalhotracodes/"
                target="_blank"
                rel="noreferrer"
                aria-label="LinkedIn profile"
                title="LinkedIn"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.04c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM3.56 9h3.56v11.45H3.56V9Z"
                  ></path>
                </svg>
              </a>
              <a
                class="social-icon-link"
                href="https://x.com/rohangotnochill"
                target="_blank"
                rel="noreferrer"
                aria-label="X profile"
                title="X"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23Zm-1.16 17.52h1.84L7.08 4.13H5.12l11.96 15.64Z"
                  ></path>
                </svg>
              </a>
              <a
                class="social-icon-link"
                href="https://github.com/rohanmalhotracodes"
                target="_blank"
                rel="noreferrer"
                aria-label="GitHub profile"
                title="GitHub"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.36-3.9-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.57-.29-5.27-1.28-5.27-5.68 0-1.25.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.96 10.96 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.1 0 4.41-2.71 5.39-5.29 5.68.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
                  ></path>
                </svg>
              </a>
            </div>
          </nav>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© 2026 Rohan Malhotra.</span>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const loadingMessage = document.querySelector('[data-loading-message]');
        const loadingDetail = document.querySelector('[data-loading-detail]');
        let readinessTimer;

        const resetMessage = () => {
          if (loadingMessage) {
            loadingMessage.textContent = 'Loading GSoC Organizations…';
          }
          if (loadingDetail) loadingDetail.textContent = 'Preparing the page';
        };

        const markReady = () => {
          window.clearTimeout(readinessTimer);
          root.classList.remove('page-navigating');
          root.classList.add('page-ready');
          resetMessage();
        };

        const showNavigationLoading = (label) => {
          if (loadingMessage) {
            loadingMessage.textContent = label
              ? `Opening ${label}…`
              : 'Opening page…';
          }
          if (loadingDetail) {
            loadingDetail.textContent =
              'This may take a moment on a slow connection';
          }
          root.classList.add('page-navigating');
        };

        const scheduleNavigationLoading = (label) => {
          showNavigationLoading(label);
        };

        const isExplorerPage =
          window.location.pathname === '/' ||
          window.location.pathname === '/shortlist/';
        readinessTimer = window.setTimeout(markReady, 8000);

        if (isExplorerPage) {
          window.addEventListener('gsoc:explorer-ready', markReady, {
            once: true,
          });
          if (
            document.querySelector(
              '[data-testid="explorer"][data-ready="true"]',
            )
          ) {
            markReady();
          }
        } else if (document.readyState === 'complete') {
          markReady();
        } else {
          window.addEventListener('load', markReady, { once: true });
        }

        document.addEventListener(
          'click',
          (event) => {
            if (
              event.defaultPrevented ||
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey ||
              !(event.target instanceof Element)
            ) {
              return;
            }

            const link = event.target.closest('a[href]');
            if (
              !link ||
              link.target === '_blank' ||
              link.hasAttribute('download')
            ) {
              return;
            }

            const destination = new URL(link.href, window.location.href);
            if (
              destination.origin !== window.location.origin ||
              destination.protocol !== window.location.protocol ||
              (destination.pathname === window.location.pathname &&
                destination.search === window.location.search) ||
              destination.hash
            ) {
              return;
            }

            const label =
              link.getAttribute('aria-label') || link.textContent?.trim();
            scheduleNavigationLoading(label);
          },
          { capture: true },
        );

        document.addEventListener('submit', (event) => {
          if (!(event.target instanceof HTMLFormElement)) return;
          const destination = new URL(
            event.target.action || window.location.href,
            window.location.href,
          );
          if (destination.origin !== window.location.origin) return;
          scheduleNavigationLoading('search results');
        });

        window.addEventListener('pageshow', (event) => {
          if (event.persisted) markReady();
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const countElements = document.querySelectorAll(
          '[data-github-star-count]',
        );
        const statusElements = document.querySelectorAll(
          '[data-github-star-status]',
        );
        if (!countElements.length) return;

        const cacheKey = 'gsoc-organizations-github-stars';
        const cacheDuration = 15 * 60 * 1000;

        const showCount = (count) => {
          const formattedCount = new Intl.NumberFormat().format(count);
          countElements.forEach((element) => {
            element.textContent = formattedCount;
          });
          statusElements.forEach((element) => {
            element.textContent = `${formattedCount} GitHub ${count === 1 ? 'star' : 'stars'}`;
          });
        };

        try {
          const cached = JSON.parse(sessionStorage.getItem(cacheKey) || 'null');
          if (
            cached &&
            Number.isInteger(cached.count) &&
            Date.now() - cached.updatedAt < cacheDuration
          ) {
            showCount(cached.count);
            return;
          }
        } catch {}

        fetch(
          'https://api.github.com/repos/rohanmalhotracodes/GSoC-Organizations',
          { headers: { Accept: 'application/vnd.github+json' } },
        )
          .then((response) => {
            if (!response.ok) throw new Error('Unable to load GitHub stars');
            return response.json();
          })
          .then((repository) => {
            if (!Number.isInteger(repository.stargazers_count)) return;
            showCount(repository.stargazers_count);
            try {
              sessionStorage.setItem(
                cacheKey,
                JSON.stringify({
                  count: repository.stargazers_count,
                  updatedAt: Date.now(),
                }),
              );
            } catch {}
          })
          .catch(() => {
            statusElements.forEach((element) => {
              element.textContent = 'View repository stars on GitHub';
            });
          });
      })();
    </script>
  </body>
</html>
