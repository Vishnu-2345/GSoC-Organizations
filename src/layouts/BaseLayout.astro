---
import '../styles/global.css';

interface Props {
  description?: string;
}

const {
  description = 'Search, compare, and shortlist Google Summer of Code organizations using public archive data and transparent source links.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F9AB00" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/brand/gsoc-organizations-favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/brand/gsoc-organizations-favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/brand/gsoc-organizations-favicon-16x16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/brand/gsoc-organizations-apple-touch-icon.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <title>GSoC Organizations</title>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div id="main-content">
      <slot />
    </div>
    <footer class="site-footer">
      <div>
        <strong>GSoC Organizations</strong>
        <p>
          An independent, privacy-friendly explorer built from public GSoC
          archive data.
        </p>
      </div>
      <div>
        <span>No analytics. No advertising. Browser-local notes.</span>
        <nav aria-label="Footer navigation">
          <a href="/">Directory</a>
          <a href="/shortlist/">Shortlist</a>
          <a href="/about/">About the data</a>
          <a
            href="https://summerofcode.withgoogle.com/"
            target="_blank"
            rel="noreferrer">Official GSoC ↗</a
          >
        </nav>
      </div>
    </footer>
  </body>
</html>
