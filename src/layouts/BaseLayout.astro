---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'GSoC Atlas — Explore open-source organizations',
  description = 'Search, compare, and shortlist Google Summer of Code organizations using public archive data and transparent source links.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0866FF" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div id="main-content">
      <slot />
    </div>
    <footer class="site-footer">
      <div>
        <strong>GSoC Atlas</strong>
        <p>
          An independent, privacy-friendly explorer built from public GSoC
          archive data.
        </p>
      </div>
      <div>
        <span>No analytics. No advertising. Browser-local notes.</span>
        <nav aria-label="Footer navigation">
          <a href="/">Directory</a>
          <a href="/shortlist/">Shortlist</a>
          <a href="/about/">About the data</a>
          <a
            href="https://summerofcode.withgoogle.com/"
            target="_blank"
            rel="noreferrer">Official GSoC ↗</a
          >
        </nav>
      </div>
    </footer>
  </body>
</html>
