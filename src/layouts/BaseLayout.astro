---
import '../styles/global.css';

interface Props {
  description?: string;
}

const {
  description = 'Search, compare, and shortlist Google Summer of Code organizations using public archive data and transparent source links.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F9AB00" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/brand/gsoc-organizations-favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/brand/gsoc-organizations-favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/brand/gsoc-organizations-favicon-16x16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/brand/gsoc-organizations-apple-touch-icon.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <title>GSoC Organizations</title>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div id="main-content">
      <slot />
    </div>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a
            class="footer-brand-link"
            href="/"
            aria-label="GSoC Organizations footer home"
          >
            <img
              src="/brand/gsoc-organizations-logo.svg"
              alt=""
              width="54"
              height="54"
            />
            <span>GSoC Organizations</span>
          </a>
          <p>
            A comprehensive directory of past and present Google Summer of Code
            (GSoC) organizations, helping aspiring open-source contributors
            discover projects, explore participation history, and find
            opportunities to contribute.
          </p>
        </div>
        <div class="footer-link-grid">
          <nav class="footer-column" aria-labelledby="footer-explore-heading">
            <h2 id="footer-explore-heading">Explore</h2>
            <a href="/">Directory</a>
            <a href="/shortlist/">Shortlist</a>
            <a href="/about/">About the data</a>
          </nav>
          <nav class="footer-column" aria-labelledby="footer-project-heading">
            <h2 id="footer-project-heading">Project</h2>
            <a href="/privacy/">Privacy policy</a>
            <a
              href="https://github.com/rohanmalhotracodes/GSoC-Organizations"
              target="_blank"
              rel="noreferrer">GitHub repository ↗</a
            >
            <a
              href="https://summerofcode.withgoogle.com/"
              target="_blank"
              rel="noreferrer">Official GSoC ↗</a
            >
          </nav>
          <nav class="footer-column" aria-labelledby="footer-creator-heading">
            <h2 id="footer-creator-heading">Created by</h2>
            <p>Made by <strong>Rohan Malhotra</strong>.</p>
            <a
              href="https://www.linkedin.com/in/rohanmalhotracodes/"
              target="_blank"
              rel="noreferrer">LinkedIn ↗</a
            >
            <a
              href="https://x.com/rohangotnochill"
              target="_blank"
              rel="noreferrer">X ↗</a
            >
            <a
              href="https://github.com/rohanmalhotracodes"
              target="_blank"
              rel="noreferrer">GitHub profile ↗</a
            >
          </nav>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© 2026 Rohan Malhotra. Built for the open-source community.</span>
        <p>
          This independent project uses public GSoC archive data and is not
          affiliated with or endorsed by Google.
        </p>
      </div>
    </footer>
  </body>
</html>
